#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "$repo_root/scripts/portable-environment"
cd "$repo_root"
cargo build -p testctl -p testlab-reference-adapter
rm -rf target/reference-qualification-evidence
target/debug/testctl qualify \
  --root . \
  --qualification qualifications/repository-pr.toml \
  --subject subjects/reference-rust.toml \
  --evidence-dir target/reference-qualification-evidence
