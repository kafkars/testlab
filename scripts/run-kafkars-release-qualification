#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
evidence_directory="${TESTLAB_EVIDENCE_DIR:-${repository_root}/target/kafkars-release-evidence}"

cd "${repository_root}"
cargo build -p testctl -p testlab-kafkars-adapter
target/debug/testctl qualify \
  --root . \
  --qualification qualifications/kafkars-release.toml \
  --subject subjects/kafkars-rust.toml \
  --evidence-dir "${evidence_directory}"
