#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
if [[ $# -ne 1 ]]; then
  echo "usage: scripts/replay <sealed-evidence-directory>" >&2
  exit 2
fi
reproduction="$1/reproduction.sh"
if [[ ! -x "$reproduction" ]]; then
  echo "missing executable reproduction script: $reproduction" >&2
  exit 2
fi
exec "$reproduction"
